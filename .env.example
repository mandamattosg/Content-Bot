APP_NAME=Content Radar
ENVIRONMENT=development
TIMEZONE=America/Sao_Paulo

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/content_radar
DATA_RETENTION_DAYS=15

GEMINI_API_KEY=your_gemini_api_key
TELEGRAM_TOKEN=your_telegram_token
TELEGRAM_CHAT_ID=your_chat_id

COLLECTOR_RETRY_ATTEMPTS=3
COLLECTOR_RETRY_DELAY_SECONDS=1.5
COLLECTOR_TIMEOUT_SECONDS=15
REDDIT_USER_AGENT=Mozilla/5.0 ContentRadar/0.1

ANALYSIS_MAX_TOTAL_SIGNALS=40
ANALYSIS_MAX_NEWS_SIGNALS=20
ANALYSIS_MAX_REDDIT_SIGNALS=15
ANALYSIS_MAX_TRENDS_SIGNALS=10
ANALYSIS_MAX_CONTENT_LENGTH=600

ENABLE_SCHEDULER=false
SCHEDULER_HOUR=8
SCHEDULER_MINUTE=0
